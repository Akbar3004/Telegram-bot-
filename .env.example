# BotFather'dan olingan token
BOT_TOKEN=123456:ABC-DEF...

# Bot adminlarining Telegram ID'lari (vergul bilan). ID'ni @userinfobot orqali bilish mumkin
ADMIN_IDS=111111111,222222222

# (ixtiyoriy) Kuzatiladigan guruh ID'si. Bo'sh qolsa, guruhda /bind buyrug'i bilan ulanadi
GROUP_ID=

# Ma'lumotlar bazasi.
#   Server/Docker: sqlite+aiosqlite:///data/bot.db
#   Vercel: PostgreSQL shart (Neon yoki Supabase bergan postgres://... havolasini shundayligicha qo'ying)
DATABASE_URL=sqlite+aiosqlite:///data/bot.db

# Faqat Vercel (webhook) uchun: 16-256 belgili tasodifiy maxfiy kalit (A-Z, a-z, 0-9, _ va -)
# Yaratish: python -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_SECRET=

# (ixtiyoriy) AI post uchun Gemini API kaliti: https://aistudio.google.com -> Get API key
GEMINI_API_KEY=
# (ixtiyoriy) Rasm modeli, standart: gemini-2.5-flash-image
GEMINI_IMAGE_MODEL=
