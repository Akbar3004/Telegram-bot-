{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/api/webhook", "destination": "/api/index?route=webhook" },
    { "source": "/api/setup", "destination": "/api/index?route=setup" },
    { "source": "/(.*)", "destination": "/api/index" }
  ]
}
